# Local development (Vite dev server has no proxy; backend runs on :8080)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ASSET_BASE_URL=http://localhost:8080

# Production (Nginx same-origin): set as Docker build args instead, e.g.
#   docker build --build-arg VITE_API_BASE_URL=/api/v1 --build-arg VITE_ASSET_BASE_URL= ...
# VITE_API_BASE_URL=/api/v1
# VITE_ASSET_BASE_URL=
